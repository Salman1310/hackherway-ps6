# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Find exact model ID: AWS Console → Bedrock → Model catalog
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0

# SQLite — path relative to backend/ folder
SQLITE_DB_PATH=./hackherway.db

# ServiceNow (Phase 7+)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# MS Teams Incoming Webhook
TEAMS_WEBHOOK_URL=

# Public URL where the frontend is reachable (used in Teams card links)
FRONTEND_PUBLIC_URL=http://localhost:3000

# n8n webhook URL for Jira ticket routing (optional — leave empty to skip)
N8N_WEBHOOK_URL=

# Server
PORT=8000
