{
  "name": "HackHERway - Jira Ticket Routing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hackherway-jira",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Receive from HackHERway",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "hackherway-jira-webhook"
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.jira_items",
        "options": {}
      },
      "id": "split-node",
      "name": "Split Jira Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "jira-routed-check",
              "leftValue": "={{ $json.jira_routed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-node",
      "name": "Is Jira Routed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "create",
        "project": {
          "__rl": true,
          "value": "={{ $('Receive from HackHERway').item.json.body.jira_project_key ?? 'ACC' }}",
          "mode": "name"
        },
        "summary": "=[Access Request] {{ $('Receive from HackHERway').item.json.body.requester_name }} — {{ $json.display_name }}",
        "additionalFields": {
          "description": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Access Request Details"
                  }
                ]
              },
              {
                "type": "bulletList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "={{ 'Requester: ' + $('Receive from HackHERway').item.json.body.requester_name + ' (' + $('Receive from HackHERway').item.json.body.acf2_id + ')' }}" }] }]
                  },
                  {
                    "type": "listItem",
                    "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "={{ 'Role: ' + $('Receive from HackHERway').item.json.body.role_title }}" }] }]
                  },
                  {
                    "type": "listItem",
                    "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "={{ 'Team: ' + $('Receive from HackHERway').item.json.body.team }}" }] }]
                  },
                  {
                    "type": "listItem",
                    "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "={{ 'Access Item: ' + $json.display_name + ' (' + $json.id + ')' }}" }] }]
                  },
                  {
                    "type": "listItem",
                    "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "={{ 'System: ' + $json.system }}" }] }]
                  },
                  {
                    "type": "listItem",
                    "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "={{ 'Catalog ID: ' + ($json.catalog_id || 'N/A') }}" }] }]
                  },
                  {
                    "type": "listItem",
                    "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "={{ 'Request ID: ' + $('Receive from HackHERway').item.json.body.request_id }}" }] }]
                  }
                ]
              }
            ]
          },
          "labels": ["access-request", "={{ 'ACF2:' + $('Receive from HackHERway').item.json.body.acf2_id }}"],
          "issueType": "Task",
          "priority": "Medium"
        }
      },
      "id": "jira-create-node",
      "name": "Create Jira Issue",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [900, 200],
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "REPLACE_WITH_YOUR_JIRA_CREDENTIAL_ID",
          "name": "Jira account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"skipped\", \"reason\": \"not jira routed\", \"item\": $json.id }",
        "options": {}
      },
      "id": "skip-node",
      "name": "Skip (ServiceNow handled)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Receive from HackHERway": {
      "main": [[{ "node": "Split Jira Items", "type": "main", "index": 0 }]]
    },
    "Split Jira Items": {
      "main": [[{ "node": "Is Jira Routed?", "type": "main", "index": 0 }]]
    },
    "Is Jira Routed?": {
      "main": [
        [{ "node": "Create Jira Issue", "type": "main", "index": 0 }],
        [{ "node": "Skip (ServiceNow handled)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "hackherway-ps6"
  },
  "_setup_instructions": {
    "step1": "Import this file in n8n.cloud via Settings → Import workflow",
    "step2": "Add your Jira credentials: Settings → Credentials → New → Jira Software Cloud API (email + API token from id.atlassian.com)",
    "step3": "Open the 'Create Jira Issue' node and select your Jira credential",
    "step4": "Set the Project value to your Jira project key (e.g. 'ACC' or 'IT')",
    "step5": "Activate the workflow — copy the Webhook URL from the 'Receive from HackHERway' node",
    "step6": "Paste that URL into backend/.env as N8N_WEBHOOK_URL=https://your-n8n-cloud-url/webhook/hackherway-jira",
    "jira_routed_systems": [
      "Confluence", "SharePoint", "Miro",
      "Database", "Data Warehouse", "Data Platform",
      "Postgres", "Oracle", "Redshift", "MongoDB",
      "Jira"
    ]
  }
}
